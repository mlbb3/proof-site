---
// Max's link maker. After a call: pick their trade, type their name (and
// optionally firm, town, a customer message), then copy the link or open
// WhatsApp with it ready to send. Private: not linked, not indexed, not tracked.
import Base from '../layouts/Base.astro';
import { TRADES } from '../data/trades';

const options = Object.values(TRADES).map((t) => ({ slug: t.slug, label: t.slug === 'default' ? 'No trade (general page)' : t.label }));
---
<Base title="Link maker" hidden>
  <main>
    <h1>Make their link</h1>
    <form id="lm" autocomplete="off">
      <label>Their trade
        <select name="trade">
          {options.map((o) => <option value={o.slug}>{o.label}</option>)}
        </select>
      </label>
      <label>Their name <input name="to" maxlength="40" placeholder="Steve Harris" /></label>
      <label>Their firm <span>optional</span> <input name="firm" maxlength="40" placeholder="Harris Heating" /></label>
      <label>Their town <span>optional</span> <input name="town" maxlength="30" placeholder="Leeds" /></label>
      <label>A message from one of their customers <span>optional</span>
        <textarea name="job" rows="3" maxlength="300" placeholder="Hi, the kitchen tap is leaking under the sink, could someone come Thursday?"></textarea>
      </label>
    </form>

    <p class="out" id="out"></p>
    <div class="acts">
      <a class="btn" id="wa" href="#" target="_blank" rel="noopener">Send on WhatsApp</a>
      <button class="btn-line" id="copy" type="button">Copy link</button>
      <a class="textlink" id="open" href="#" target="_blank" rel="noopener">Preview</a>
    </div>
  </main>
</Base>
<script>
  const form = document.getElementById('lm') as HTMLFormElement;
  const out = document.getElementById('out')!;
  const wa = document.getElementById('wa') as HTMLAnchorElement;
  const open = document.getElementById('open') as HTMLAnchorElement;
  const copy = document.getElementById('copy') as HTMLButtonElement;
  let url = '';
  function build() {
    const d = new FormData(form);
    const val = (k: string) => String(d.get(k) ?? '').replace(/\s+/g, ' ').trim();
    const trade = val('trade');
    const q = new URLSearchParams();
    for (const k of ['to', 'firm', 'town', 'job']) if (val(k)) q.set(k, val(k));
    const path = trade === 'default' ? '/' : `/for/${trade}/`;
    const qs = q.toString();
    url = `${location.origin}${path}${qs ? '?' + qs : ''}`;
    out.textContent = url;
    const first = val('to').split(' ')[0];
    const msg = `${first ? `Hi ${first}, ` : ''}here's what I meant on the phone: ${url}`;
    wa.href = `https://wa.me/?text=${encodeURIComponent(msg)}`;
    open.href = url;
    copy.textContent = 'Copy link';
  }
  form.addEventListener('input', build);
  copy.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(url); copy.textContent = 'Copied'; } catch { copy.textContent = 'Copy failed, press and hold the link'; }
  });
  build();
</script>
<style>
  main { max-width: 30rem; margin-inline: auto; padding: var(--s6) var(--gutter) var(--s8); }
  h1 { font-size: var(--text-lg); margin-bottom: var(--s5); }
  form { display: grid; gap: var(--s4); }
  label { display: grid; gap: 4px; font-weight: var(--w-semi); }
  label span { font-weight: var(--w-reg); color: var(--ink-3); font-size: var(--text-xs); }
  input, select, textarea {
    font: inherit; font-weight: var(--w-reg); color: var(--ink);
    min-height: 44px; padding: var(--s2) var(--s3);
    border: var(--rule-w) solid var(--rule); border-radius: 10px; background: var(--panel);
  }
  input:focus-visible, select:focus-visible, textarea:focus-visible { outline: none; border-color: var(--sys); box-shadow: 0 0 0 3px var(--sys-tint); }
  .out { margin: var(--s5) 0 var(--s3); padding: var(--s3); background: var(--panel); border-radius: 10px; font-size: var(--text-sm); overflow-wrap: anywhere; color: var(--ink-2); }
  .acts { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s3); }
</style>
