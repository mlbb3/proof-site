---
// One headline figure and its inspect panel. Reused three times on the stage.
// The value is formatted once, at the money boundary, and shown large and tabular.
// The inspect mechanic is a native <details>, so provenance is fully usable with
// no JavaScript: plain-English meaning, the six bases, the source line, what the
// figure cannot be set beside (computed from the bases, not hand-written), and the
// decision it informs.
import type { Figure } from '../data/figures';
import { BASIS_LABELS } from '../data/figures';
import { formatMoney } from '../lib/money';
import { incomparableTo } from '../lib/comparability';

interface Props {
  figure: Figure;
}

const { figure } = Astro.props;
const value = formatMoney(figure.valueMinor, figure.currency);

const bases = (Object.keys(BASIS_LABELS) as Array<keyof typeof BASIS_LABELS>).map(
  (key) => ({ label: BASIS_LABELS[key], value: figure.bases[key] })
);

// Only the figures that genuinely differ on at least one basis are listed.
const incomparable = incomparableTo(figure).filter((other) => other.differing.length > 0);
---

<article class="fig" data-stage-figure={figure.key}>
  <p class="fig__label">{figure.label}</p>
  <p class="fig__value">
    <span class="fig__amount">{value}</span>
    <span class="fig__unit">{figure.unit}</span>
  </p>

  <details class="fig__inspect">
    <summary class="fig__summary">
      <span class="fig__summary-text">Inspect this figure</span>
      <svg class="fig__caret" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path fill="none" stroke="currentColor" stroke-width="1.6" d="m4 6 4 4 4-4" />
      </svg>
    </summary>

    <div class="fig__body">
      <p class="fig__plain">{figure.plainEnglish}</p>

      <dl class="bases">
        {
          bases.map((basis) => (
            <Fragment>
              <dt class="bases__k">{basis.label}</dt>
              <dd class="bases__v">{basis.value}</dd>
            </Fragment>
          ))
        }
      </dl>

      <p class="fig__source">
        <span class="fig__tag">Source</span>
        <span>{figure.sourceLine}</span>
      </p>

      {
        incomparable.length > 0 && (
          <div class="beside">
            <p class="beside__label">Cannot be set beside</p>
            <ul class="beside__list">
              {incomparable.map((other) => (
                <li class="beside__item">
                  <span class="beside__name">{other.label}</span>
                  <span class="beside__chips">
                    {other.differing.map((diff) => (
                      <span class="chip-tint">{diff}</span>
                    ))}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <p class="fig__decision">
        <span class="fig__tag fig__tag--decision">Decision</span>
        <span>{figure.decision}</span>
      </p>
    </div>
  </details>
</article>

<style>
  .fig {
    display: flex;
    flex-direction: column;
    padding: var(--s4) 0;
  }

  .fig__label {
    color: var(--ink-2);
    font-size: var(--text-sm);
    font-weight: var(--w-med);
    line-height: var(--lead-snug);
    margin-bottom: var(--s2);
  }

  .fig__value {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--s2);
  }

  .fig__amount {
    font-size: var(--text-xl);
    font-weight: var(--w-bold);
    line-height: var(--lead-tight);
    letter-spacing: -0.01em;
    font-variant-numeric: var(--figures);
  }

  .fig__unit {
    color: var(--ink-3);
    font-size: var(--text-sm);
    font-weight: var(--w-reg);
  }

  .fig__inspect {
    margin-top: var(--s3);
    border-top: var(--rule-w) solid var(--rule);
  }

  .fig__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s2);
    min-height: 44px;
    cursor: pointer;
    list-style: none;
    color: var(--teal);
    font-size: var(--text-sm);
    font-weight: var(--w-semi);
  }

  .fig__summary::-webkit-details-marker {
    display: none;
  }

  .fig__caret {
    width: 1rem;
    height: 1rem;
    flex: none;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .fig__inspect[open] .fig__caret {
    transform: rotate(180deg);
  }

  .fig__body {
    padding-bottom: var(--s4);
  }

  .fig__plain {
    color: var(--ink);
    font-size: var(--text-base);
    line-height: var(--lead-text);
    margin-bottom: var(--s4);
  }

  .bases {
    display: grid;
    grid-template-columns: minmax(6.5rem, auto) 1fr;
    gap: var(--s1) var(--s4);
    margin: 0 0 var(--s4);
    padding: var(--s3) var(--s4);
    background: var(--panel-2);
    border-radius: var(--radius);
  }

  .bases__k {
    color: var(--ink-2);
    font-size: var(--text-sm);
    font-weight: var(--w-med);
  }

  .bases__v {
    margin: 0;
    color: var(--ink);
    font-size: var(--text-sm);
    font-variant-numeric: var(--figures);
  }

  .fig__source,
  .fig__decision {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s1) var(--s2);
    font-size: var(--text-sm);
    line-height: var(--lead-snug);
    color: var(--ink-2);
  }

  .fig__source {
    margin-bottom: var(--s4);
  }

  .fig__decision {
    margin-top: var(--s4);
    color: var(--ink);
    font-size: var(--text-base);
    line-height: var(--lead-text);
  }

  .fig__tag {
    display: inline-block;
    color: var(--ink-3);
    font-size: var(--text-sm);
    font-weight: var(--w-semi);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .fig__tag--decision {
    color: var(--teal);
  }

  .beside {
    padding: var(--s3) 0;
    border-top: var(--rule-w) solid var(--rule);
    border-bottom: var(--rule-w) solid var(--rule);
  }

  .beside__label {
    color: var(--ink-2);
    font-size: var(--text-sm);
    font-weight: var(--w-semi);
    margin-bottom: var(--s2);
  }

  .beside__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s2);
  }

  .beside__item {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s1) var(--s3);
  }

  .beside__name {
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: var(--w-med);
  }

  .beside__chips {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--s1);
  }

  .chip-tint {
    display: inline-block;
    padding: 0 var(--s2);
    background: var(--teal-tint);
    color: var(--ink);
    font-size: var(--text-sm);
    line-height: 1.5;
    border-radius: var(--radius);
  }
</style>
