---
// One evidence block, open beneath the brief: the supplier invoices, set as the
// register they are, with the PDF outline they were read from. A real table,
// job-sheet ruling, and the three fields the parser lifted out marked in the
// PDF. This is "show the paperwork, not the product": the second brief line
// resolves to rows the reader can point at.
import { EVIDENCE_INVOICES as EV } from '../data/site';

const yesterday = new Date(Date.now() - 86400000).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
});
const cell = (v: string) => v.replace('yesterday', yesterday);
---

<section class="ev" id={EV.id} aria-labelledby="ev-inv-heading">
  <div class="ev-inner">
    <h2 id="ev-inv-heading" class="ev-head"><span class="mark">{EV.heading}</span></h2>

    <div class="grid">
      <div class="table-wrap">
        <table>
          <thead>
            <tr>{EV.columns.map((c) => <th scope="col">{c}</th>)}</tr>
          </thead>
          <tbody>
            {EV.rows.map((row) => (
              <tr>
                {row.map((c, i) => (
                  <td class={i === 4 ? 'status' : i === 3 ? 'num' : ''}>{cell(c)}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <figure class="pdf">
        <div class="pdf-doc" aria-hidden="true">
          <span class="pdf-tag">{EV.pdf.label}</span>
          <span class="ln w70"></span>
          <span class="field">{cell(EV.pdf.fields[0])}</span>
          <span class="ln w50"></span>
          <span class="ln w60"></span>
          <span class="field">{cell(EV.pdf.fields[1])}</span>
          <span class="ln w40"></span>
          <span class="ln w80"></span>
          <span class="ln w55"></span>
          <span class="field total">{cell(EV.pdf.fields[2])}</span>
        </div>
        <figcaption>Three fields lifted straight from the PDF.</figcaption>
      </figure>
    </div>

    <p class="ev-caption">{EV.caption}</p>
  </div>
</section>

<style>
  .ev {
    background: var(--panel);
    padding: var(--s5) 0 var(--s6);
  }
  .ev-inner {
    max-width: 46rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .ev-head {
    font-size: var(--text-md);
    font-weight: var(--w-bold);
    margin: 0 0 var(--s4);
  }
  .mark {
    background: linear-gradient(transparent 12%, var(--mark) 12% 88%, transparent 88%);
    padding: 0 0.12em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s5);
  }

  .table-wrap {
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }
  th,
  td {
    text-align: left;
    padding: var(--s3) var(--s3) var(--s3) 0;
    border-bottom: var(--rule-w) solid var(--rule);
    white-space: nowrap;
  }
  th {
    font-weight: var(--w-semi);
    color: var(--ink-2);
    border-bottom: 2px solid var(--rule-strong);
    text-transform: uppercase;
    font-size: var(--text-xs, 0.75rem);
    letter-spacing: 0.05em;
  }
  td {
    color: var(--ink);
  }
  .num,
  td.num {
    font-variant-numeric: var(--figures);
  }
  .status {
    color: var(--sage);
    font-weight: var(--w-semi);
  }

  .pdf {
    margin: 0;
  }
  .pdf-doc {
    display: grid;
    gap: var(--s2);
    max-width: 18rem;
    padding: var(--s4);
    background: var(--panel);
    border: var(--rule-w) solid var(--rule);
    border-radius: 2px;
    box-shadow: 2px 3px 0 var(--rule);
  }
  .pdf-tag {
    font-size: var(--text-xs, 0.75rem);
    color: var(--ink-3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--s1);
  }
  .ln {
    height: 7px;
    border-radius: 2px;
    background: var(--rule);
  }
  .w40 { width: 40%; }
  .w50 { width: 50%; }
  .w55 { width: 55%; }
  .w60 { width: 60%; }
  .w70 { width: 70%; }
  .w80 { width: 80%; }
  .field {
    font-size: var(--text-sm);
    font-weight: var(--w-medium);
    font-variant-numeric: var(--figures);
    color: var(--ink);
    background: linear-gradient(transparent 12%, var(--mark) 12% 88%, transparent 88%);
    align-self: start;
    justify-self: start;
    padding: 0 0.12em;
  }
  .field.total {
    font-weight: var(--w-bold);
  }
  figcaption {
    margin-top: var(--s2);
    font-size: var(--text-sm);
    color: var(--ink-3);
  }

  .ev-caption {
    margin: var(--s5) 0 0;
    font-size: var(--text-sm);
    color: var(--ink-2);
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: 1.4fr 1fr;
      align-items: start;
      gap: var(--s6);
    }
  }
</style>
