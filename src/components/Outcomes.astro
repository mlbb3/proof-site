---
import { OUTCOMES_HEADING, OUTCOMES } from '../data/site';
---

<section class="outcomes" aria-labelledby="outcomes-heading">
  <div class="outcomes-inner">
    <h2 id="outcomes-heading">{OUTCOMES_HEADING}</h2>
    <ul class="list">
      {OUTCOMES.map((o) => (
        <li>
          <span class="tick" aria-hidden="true">
            <svg viewBox="0 0 20 20" width="18" height="18" focusable="false">
              <path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="M4 10.5l4 4 8-9"></path>
            </svg>
          </span>
          <span class="item">
            <span class="item-title">{o.title}.</span>{' '}
            <span class="item-body">{o.body}</span>
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .outcomes {
    background: var(--ground);
    padding: var(--s6) 0;
  }
  .outcomes-inner {
    max-width: 46rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  h2 {
    font-size: var(--text-lg);
    font-weight: var(--w-bold);
    margin: 0 0 var(--s5);
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s4);
  }
  li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s3);
    align-items: start;
    padding-bottom: var(--s4);
    border-bottom: var(--rule-w) solid var(--rule);
  }
  li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .tick {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: var(--sage-tint);
    color: var(--sage);
    flex: 0 0 auto;
    margin-top: 2px;
  }
  .item-title {
    font-weight: var(--w-bold);
    color: var(--ink);
  }
  .item-body {
    color: var(--ink-2);
    line-height: var(--lead-text);
  }
</style>
