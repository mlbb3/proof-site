---
// The inspectable hero: "click a number, see what it is, what it can't be
// compared to, and the decision it drives."
//
// Resilience model (from the rebuild spec): every fact is server-rendered and
// present with JavaScript off. All three panels are visible by default; the
// client script only turns this into a compact click-to-inspect view AFTER its
// handlers are bound, by adding `is-enhanced` to the root. If the script never
// runs, the figures are anchor links to their panels: no dead controls.
import { FIGURES, BASIS_LABELS, incomparableTo, type FigureBases } from '../data/figures';
import { formatMoney } from '../lib/format';

const basisKeys = Object.keys(BASIS_LABELS) as Array<keyof FigureBases>;
---

<section class="hero" aria-labelledby="hero-heading" data-hero>
  <div class="hero-inner">
    <p class="eyebrow">Working example. Papote, a real client system. Synthetic values on the real structure.</p>
    <h1 id="hero-heading">Three numbers here mean revenue. Only one answers a given question.</h1>
    <p class="lede">
      Every headline figure carries its own basis. Two figures can only be compared
      when all six match. Pick one to see its source, its basis, what it must not be
      set beside, and the call it informs.
    </p>

    <div class="figures" role="list">
      {FIGURES.map((f, i) => (
        <a
          class="fig"
          href={`#panel-${f.key}`}
          role="listitem"
          data-fig={f.key}
          aria-current={i === 0 ? 'true' : 'false'}
        >
          <span class="fig-label">{f.label}</span>
          <span class="fig-value figure">
            {formatMoney(f.valueMinor, f.currency)}
            <span class="fig-unit">{f.unit}</span>
          </span>
        </a>
      ))}
    </div>

    <div class="panels">
      {FIGURES.map((f, i) => {
        const cannot = incomparableTo(f);
        return (
          <article class="panel" id={`panel-${f.key}`} data-panel={f.key} data-selected={i === 0 ? 'true' : undefined}>
            <p class="panel-plain">{f.plainEnglish}</p>

            <dl class="bases" aria-label="The six bases this figure declares">
              {basisKeys.map((k) => (
                <div class="basis">
                  <dt>{BASIS_LABELS[k]}</dt>
                  <dd class="figure">{f.bases[k]}</dd>
                </div>
              ))}
            </dl>

            <p class="panel-source">
              <span class="panel-source-key">Source</span>
              <span class="figure">{f.sourceLine}</span>
            </p>

            <div class="cannot">
              <p class="cannot-head">Cannot be set beside</p>
              <ul>
                {cannot.map((c) => (
                  <li>
                    <span class="cannot-label">{c.label}</span>
                    <span class="cannot-why">
                      differs on {c.differing.map((d, di) => (
                        <><span class="mark">{d}</span>{di < c.differing.length - 1 ? ', ' : ''}</>
                      ))}
                    </span>
                  </li>
                ))}
              </ul>
            </div>

            <p class="decision"><span class="decision-key">The call it informs</span>{f.decision}</p>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--paper);
    padding: var(--space-7) 0 var(--space-8);
  }
  .hero-inner {
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .eyebrow {
    font-size: var(--text-xs);
    color: var(--ink-2);
    margin: 0 0 var(--space-4);
  }
  h1 {
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
    max-width: 20ch;
    margin: 0 0 var(--space-4);
  }
  .lede {
    font-size: var(--text-md);
    color: var(--ink-2);
    max-width: var(--measure);
    margin: 0 0 var(--space-6);
  }

  /* Figures: a ruled row, not cards. Selected figure carries an ink underline. */
  .figures {
    display: grid;
    grid-template-columns: 1fr;
    border-top: var(--rule-w) solid var(--rule-strong);
    margin-bottom: var(--space-6);
  }
  .fig {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4) 0;
    border-bottom: var(--rule-w) solid var(--rule);
    text-decoration: none;
    color: var(--ink);
    box-shadow: inset 0 -3px 0 transparent;
  }
  .fig[aria-current='true'] {
    box-shadow: inset 0 -3px 0 var(--ink);
  }
  .fig-label {
    font-size: var(--text-sm);
    color: var(--ink-2);
  }
  .fig-value {
    font-size: var(--text-lg);
    font-weight: var(--weight-heading);
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }
  .fig-unit {
    font-size: var(--text-xs);
    font-weight: var(--weight-text);
    color: var(--ink-3);
  }

  /* Panels */
  .panel {
    border-top: var(--rule-w) solid var(--rule-strong);
    padding-top: var(--space-5);
    margin-top: var(--space-6);
  }
  .panel:first-child {
    margin-top: 0;
  }
  .panel-plain {
    font-size: var(--text-md);
    max-width: var(--measure);
    margin: 0 0 var(--space-5);
  }
  .bases {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    margin: 0 0 var(--space-5);
    border-top: var(--rule-w) solid var(--rule);
  }
  .basis {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    border-bottom: var(--rule-w) solid var(--rule);
  }
  .basis dt {
    font-size: var(--text-sm);
    color: var(--ink-2);
    font-weight: var(--weight-medium);
  }
  .basis dd {
    margin: 0;
    font-size: var(--text-sm);
  }
  .panel-source {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: baseline;
    font-size: var(--text-sm);
    color: var(--ink-2);
    margin: 0 0 var(--space-5);
  }
  .panel-source-key {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-3);
  }

  .cannot {
    margin: 0 0 var(--space-5);
  }
  .cannot-head {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    margin: 0 0 var(--space-2);
  }
  .cannot ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .cannot li {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: var(--space-2) 0;
    border-bottom: var(--rule-w) solid var(--rule);
    font-size: var(--text-sm);
  }
  .cannot-label {
    font-weight: var(--weight-medium);
  }
  .cannot-why {
    color: var(--ink-2);
  }

  .decision {
    font-size: var(--text-md);
    max-width: var(--measure);
    margin: 0;
  }
  .decision-key {
    display: block;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-3);
    margin-bottom: var(--space-1);
  }

  /* Enhanced (JS on): only the selected panel shows. Figure layout is governed
     by the width media query below, identical in both modes. */
  :global([data-hero].is-enhanced) .panel:not([data-selected]) {
    display: none;
  }
  :global([data-hero].is-enhanced) .panel {
    margin-top: 0;
  }
  :global([data-hero].is-enhanced) .panel[data-selected] {
    animation: settle var(--dur-move) var(--ease-out);
  }

  @keyframes settle {
    from {
      opacity: 0;
      transform: translateY(var(--move-distance));
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 700px) {
    .figures {
      grid-template-columns: repeat(3, 1fr);
      column-gap: var(--space-6);
    }
    .fig {
      border-bottom: none;
    }
    :global([data-hero].is-enhanced) .fig {
      border-bottom: none;
    }
  }
</style>

<script>
  // Progressive enhancement. Bind first, then switch on the compact view, so a
  // script failure leaves every panel visible and every figure a working anchor.
  import { enhanceHero } from '../scripts/hero';
  enhanceHero();
</script>
