---
// The brief: the 07:00 message as a record. Sender line, "Yesterday", six
// marked lines that each link to their paperwork, then "Today". Under it the
// Run button, Skip, and the caption strip the replay writes into. The end
// state of the replay is exactly this markup; the replay only hides and
// reveals what is already here.
import { formatMoney } from '../lib/money';
import {
  type Trade, invoiceTotalPence, plannedHours, loggedHours, priceDriftPct, fmtHours,
} from '../data/trades';
import { BRIEF_UI } from '../data/site';

interface Props {
  trade: Trade;
}
const { trade: t } = Astro.props;

const flagged = t.prices.find((p) => p.flagged)!;
const lines = [
  { id: 'enquiry-log', mark: `${t.enquiries.length} new enquiries.`, rest: 'Replies drafted in your voice, waiting for you.' },
  { id: 'invoice-register', mark: `${t.invoices.length} supplier invoices in,`, rest: `${formatMoney(invoiceTotalPence(t), 'GBP')} total. Read and filed.` },
  { id: 'job-book', mark: `${t.jobs.length} jobs booked`, rest: 'for next week, straight from the confirmation emails.' },
  { id: 'timesheet', mark: `Hours: ${fmtHours(loggedHours(t))} logged against ${fmtHours(plannedHours(t))} planned.`, rest: 'One gap flagged.' },
  { id: 'sales-ledger', mark: `Invoiced ${formatMoney(t.invoicedPence, 'GBP')}, paid ${formatMoney(t.paidPence, 'GBP')}.`, rest: `${t.overdue.length === 2 ? 'Two' : t.overdue.length} invoices now over 30 days.` },
  { id: 'supplier-prices', mark: `${flagged.supplier} charged ${priceDriftPct(t)}% more`, rest: `for the same ${t.part.split(',')[0].toLowerCase()} than back in ${t.prices[0].when}.` },
];
---

<section class="brief-wrap" id="brief">
  <p class="lead-in">{BRIEF_UI.leadIn}</p>

  <article class="stage" aria-labelledby="brief-day">
    <header class="msg-head">
      <span class="clock">{BRIEF_UI.time}</span>
      <span class="to">to {t.owner}'s phone</span>
      <span class="firm">{t.firm}</span>
    </header>

    <h2 id="brief-day" class="day">{BRIEF_UI.yesterday}</h2>
    <p class="reading" id="brief-reading" aria-hidden="true">Reading last night</p>

    <ol class="lines" id="brief-lines">
      {lines.map((l) => (
        <li>
          <a class="line" href={`#${l.id}`}>
            <span class="line-text"><span class="mark">{l.mark}</span> {l.rest}</span>
            <svg class="chev" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" d="M6 3l5 5-5 5"></path></svg>
          </a>
        </li>
      ))}
    </ol>

    <div class="today" id="brief-today">
      <h3>{BRIEF_UI.today}</h3>
      <ul>{t.today.map((x) => <li>{x}</li>)}</ul>
    </div>
  </article>

  <div class="controls" id="brief-controls" hidden>
    <button class="btn-line" type="button" id="run" data-run={BRIEF_UI.run} data-again={BRIEF_UI.runAgain}>
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><path fill="currentColor" d="M4 2.5v11l9-5.5z"></path></svg>
      <span id="run-label">{BRIEF_UI.run}</span>
    </button>
    <button class="textlink" type="button" id="skip" hidden>{BRIEF_UI.skip}</button>
    <p class="caption" id="caption" aria-live="polite"></p>
  </div>

  <p class="under">{BRIEF_UI.under}</p>
  <p class="mock measure">{BRIEF_UI.mock}</p>
</section>

<script>
  import { mountReplay } from '../scripts/replay';
  mountReplay();
</script>

<style>
  .brief-wrap {
    padding: var(--s5) 0 var(--s4);
  }
  .lead-in {
    font-size: var(--text-md);
    color: var(--ink-2);
    margin: 0 0 var(--s4);
  }
  /* The message record sits on a faint-teal mat: the one soft-colour moment. */
  .stage {
    background: var(--ground);
    border: var(--rule-w) solid var(--rule);
    border-radius: var(--radius);
    padding: var(--s5);
  }
  .msg-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s2) var(--s3);
    padding-bottom: var(--s3);
    border-bottom: var(--rule-w) solid var(--rule);
  }
  .clock {
    font-variant-numeric: var(--figures);
    font-weight: var(--w-bold);
    color: var(--teal);
    font-size: var(--text-md);
  }
  .to {
    color: var(--ink-2);
    font-size: var(--text-sm);
  }
  .firm {
    margin-left: auto;
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .day,
  .today h3 {
    font-size: var(--text-sm);
    font-weight: var(--w-semi);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-2);
    margin: var(--s4) 0 var(--s2);
  }
  .reading {
    display: none;
    color: var(--ink-3);
    font-size: var(--text-sm);
    margin: var(--s3) 0;
  }
  .reading.on {
    display: block;
  }
  .lines {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .lines li {
    border-bottom: var(--rule-w) solid var(--rule);
  }
  .line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s3);
    padding: var(--s3) var(--s1) var(--s3) 0;
    text-decoration: none;
    color: var(--ink);
  }
  .line-text {
    font-size: var(--text-md);
    line-height: var(--lead-snug);
  }
  .line .mark {
    font-weight: var(--w-semi);
  }
  .chev {
    flex: 0 0 auto;
    color: var(--teal);
  }
  .line:hover .line-text,
  .line:focus-visible .line-text {
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 3px;
  }
  .today {
    margin-top: var(--s3);
    padding-top: var(--s2);
    border-top: 2px solid var(--rule);
  }
  .today ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s2);
  }
  .today li {
    line-height: var(--lead-snug);
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s3) var(--s4);
    margin-top: var(--s4);
  }
  .controls[hidden] {
    display: none;
  }
  .caption {
    flex-basis: 100%;
    min-height: 1.4em;
    color: var(--ink-2);
    font-size: var(--text-sm);
    margin: 0;
  }
  .under {
    margin: var(--s4) 0 0;
    font-size: var(--text-md);
  }
  .mock {
    margin: var(--s3) 0 0;
    font-size: var(--text-sm);
    color: var(--ink-3);
    line-height: var(--lead-text);
  }
</style>
