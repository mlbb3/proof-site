---
// The first-screen identity line and the contact row.
// Placeholder copy (copy is written last). The mandatory honesty label sits here,
// on the first screen, so the reader meets it before the stage. Contact lives at
// the foot of fold 1: a teal WhatsApp button and an ordinary email route for a
// forwarded reader. Fully server-rendered; no JavaScript.
---

<section class="identity" aria-label="Identity and contact">
  <p class="identity__eyebrow">
    Working example. Papote, a real client system. Synthetic values on the real
    structure.
  </p>

  <h1 class="identity__name">Max Brown, back-office automation</h1>
  <p class="identity__sub">
    Pipelines that reconcile the books, hold what does not add up, and settle into
    a decision you can act on.
  </p>

  <div class="identity__contact" data-stage-contact>
    <a class="wa" href="https://wa.me/447531188098">
      <svg class="wa__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          fill="currentColor"
          d="M12 2a10 10 0 0 0-8.6 15.05L2 22l5.1-1.34A10 10 0 1 0 12 2Zm0 18a8 8 0 0 1-4.08-1.12l-.29-.17-3.03.8.81-2.95-.19-.3A8 8 0 1 1 12 20Zm4.4-5.87c-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06a6.5 6.5 0 0 1-1.92-1.18 7.2 7.2 0 0 1-1.33-1.66c-.14-.24 0-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.2-.47-.4-.4-.54-.41h-.46a.9.9 0 0 0-.64.3 2.68 2.68 0 0 0-.84 2c0 1.18.86 2.32 .98 2.48.12.16 1.7 2.6 4.12 3.64.58.25 1.03.4 1.38.51.58.19 1.1.16 1.52.1.46-.07 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28Z"
        />
      </svg>
      <span>Message on WhatsApp</span>
    </a>

    <a class="email" href="mailto:hello@[domain]">hello@[domain]</a>
  </div>
</section>

<style>
  .identity {
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--s7) var(--gutter) var(--s5);
  }

  .identity__eyebrow {
    color: var(--ink-2);
    font-size: var(--text-sm);
    font-weight: var(--w-med);
    letter-spacing: 0.01em;
    max-width: 46ch;
    margin-bottom: var(--s5);
  }

  .identity__name {
    font-size: var(--text-xl);
    font-weight: var(--w-bold);
    line-height: var(--lead-tight);
    letter-spacing: -0.01em;
    max-width: 20ch;
  }

  .identity__sub {
    color: var(--ink-2);
    font-size: var(--text-md);
    line-height: var(--lead-text);
    max-width: 52ch;
    margin-top: var(--s3);
  }

  .identity__contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s4);
    margin-top: var(--s5);
  }

  .wa {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    min-height: 44px;
    padding: var(--s2) var(--s5);
    background: var(--teal);
    color: var(--panel);
    font-weight: var(--w-semi);
    font-size: var(--text-base);
    text-decoration: none;
    border-radius: var(--radius);
  }

  .wa:hover {
    background: var(--teal);
    filter: brightness(1.08);
  }

  .wa__icon {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
  }

  .email {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--teal);
    font-weight: var(--w-med);
    font-size: var(--text-base);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  @media (min-width: 768px) {
    .identity {
      padding-top: var(--s8);
    }
  }
</style>
