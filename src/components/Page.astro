---
// Follow one job (brief v2). Opens on the 07:00 email so the system is in the
// first screen; one line in it is the job the page follows down; the page then
// zooms out to the week. SLICE 1: top + beat 1 + close. Beats 2-4 and call
// mode follow once this slice is approved.
import Base from '../layouts/Base.astro';
import FlowHero from './flow/FlowHero.astro';
import EmailMock from './flow/EmailMock.astro';
import BeatMessage from './flow/BeatMessage.astro';
import FlowClose from './flow/FlowClose.astro';
import type { Trade } from '../data/trades';

interface Props { trade: Trade }
const { trade } = Astro.props;
const title = trade.slug === 'default'
  ? 'Max Brown. Your admin, done overnight.'
  : `Max Brown. Your admin, done overnight, for ${trade.label.toLowerCase()}.`;
---
<Base title={title} description="Enquiries answered, invoices chased, one plain message every morning. Built and run by Max Brown.">
  <main data-trade={trade.slug}>
    <FlowHero trade={trade} />
    <EmailMock trade={trade} />
    <div class="gap" aria-hidden="true"></div>
    <BeatMessage trade={trade} />
    <FlowClose />
  </main>
</Base>
<script>
  import '../scripts/flow';
</script>
<style>
  main {
    max-width: 34rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .gap { height: var(--s6); }
</style>
