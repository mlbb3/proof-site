---
// The 07:00 morning email, shown as the email it is: sender, time, subject,
// then tiles. Opens the page so the system is visible in the first screen.
// One enquiry row is the job the page then follows down. Stat tiles use
// proportional figures, no hero-metric template. Colour = state only.
import Icon from './Icon.astro';
import { formatMoney } from '../../lib/money';
import { type Trade, priceDriftPct } from '../../data/trades';
import { FLOW } from '../../data/site';

interface Props { trade: Trade }
const { trade: t } = Astro.props;

const followed = t.enquiries[0];
const others = t.enquiries.slice(1);
const overdue = t.overdue.reduce((s, o) => s + o.amountPence, 0);
const notDue = Math.max(0, t.invoicedPence - t.paidPence);
const owed = overdue + notDue;
const pctNotDue = Math.round((notDue / owed) * 100);
const drift = priceDriftPct(t);
const flagged = t.prices.find((p) => p.flagged)!;
const series = t.prices.filter((p) => p.supplier === flagged.supplier);
// Sparkline geometry: three points, one axis, emphasis on the last.
const vals = series.map((p) => p.unitPence);
const lo = Math.min(...vals), hi = Math.max(...vals);
const pts = vals.map((v, i) => [8 + (i * 104) / (vals.length - 1), 34 - ((v - lo) / (hi - lo || 1)) * 24]);
const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'];
const perDay = days.map((d) => t.jobs.filter((j) => j.when === d).length);
const money = (p: number) => formatMoney(p, 'GBP');
---

<section class="desk" aria-labelledby="mail-subject">
  <article class="mail">
    <header class="mail-head">
      <span class="avatar" aria-hidden="true">MB</span>
      <div class="mail-meta">
        <p class="mail-from"><span>Morning brief</span><span class="mail-time">07:00</span></p>
        <h2 class="mail-subject" id="mail-subject"><span id="mail-greet">Morning, {t.owner}.</span> {t.enquiries.length} enquiries, {money(overdue)} overdue, one price up.</h2>
      </div>
    </header>

    <div class="tiles">
      <section class="tile wide rv" style="--i:0" aria-label="Enquiries">
        <p class="tile-head"><Icon name="chat" /> Enquiries <span class="count">{t.enquiries.length} new</span></p>
        <a class="follow" href="#beat-1">
          <span class="follow-who">{followed.from}, {followed.place}</span>
          <span class="follow-what">{followed.summary}</span>
          <span class="follow-foot">
            <span class="state need"><Icon name="reply" size={15} /> {FLOW.replyReady}</span>
            <span class="follow-cue">{FLOW.follow} <span aria-hidden="true">&rsaquo;</span></span>
          </span>
        </a>
        <ul class="others">
          {others.map((e) => <li><span>{e.from}</span> <span class="muted">{e.channel}</span></li>)}
        </ul>
      </section>

      <section class="tile wide rv" style="--i:1" aria-label="Money owed to you">
        <p class="tile-head"><Icon name="pound" /> Owed to you <span class="count">{money(owed)}</span></p>
        <div class="bar" role="img" aria-label={`${money(notDue)} not due yet, ${money(overdue)} overdue`}>
          <span class="seg notdue" style={`width:${pctNotDue}%`}></span>
          <span class="seg overdue" style={`width:${100 - pctNotDue}%`}></span>
        </div>
        <p class="bar-key">
          <span><i class="sw notdue"></i> Not due yet {money(notDue)}</span>
          <span class="over-txt"><Icon name="alert" size={14} /> Overdue {money(overdue)}</span>
        </p>
        <p class="paid"><Icon name="check" size={15} /> Paid in yesterday {money(t.paidPence)}</p>
      </section>

      <section class="tile rv" style="--i:2" aria-label="Jobs booked">
        <p class="tile-head"><Icon name="calendar" /> Jobs</p>
        <p class="big">{t.jobs.length}<span> booked next week</span></p>
        <ol class="week" aria-label="Jobs per day">
          {days.map((d, i) => (
            <li><span class="dots">{Array.from({ length: perDay[i] }).map(() => <i></i>)}</span><span class="d">{d.slice(0, 1)}</span></li>
          ))}
        </ol>
      </section>

      <section class="tile rv" style="--i:3" aria-label="Supplier price">
        <p class="tile-head"><Icon name="trend" /> Prices</p>
        <p class="big over-txt">+{drift}%<span> same part, since {series[0].when}</span></p>
        <svg class="spark" viewBox="0 0 120 40" role="img" aria-label={`${flagged.supplier}: ${series.map((p) => p.when + ' ' + money(p.unitPence)).join(', ')}`}>
          <polyline points={pts.map((p) => p.join(',')).join(' ')} fill="none" stroke="var(--over)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></polyline>
          {pts.map((p, i) => <circle cx={p[0]} cy={p[1]} r={i === pts.length - 1 ? 4 : 2.5} fill={i === pts.length - 1 ? 'var(--over)' : 'var(--panel)'} stroke="var(--over)" stroke-width="2"></circle>)}
        </svg>
        <p class="spark-key"><span>{series[0].when}</span><span>{series[series.length - 1].when}</span></p>
      </section>

      <section class="tile wide rv" style="--i:4" aria-label="Today">
        <p class="tile-head"><Icon name="sun" /> Today</p>
        <ul class="today">{t.today.map((x) => <li>{x}</li>)}</ul>
      </section>
    </div>
  </article>
  <p class="honesty">{FLOW.honesty}</p>
</section>

<style>
  .desk {
    background: var(--desk);
    border-radius: 20px;
    padding: var(--s4) var(--s3) var(--s3);
  }
  .mail {
    background: var(--panel);
    border-radius: 14px;
    padding: var(--s4);
    max-width: 30rem;
    margin-inline: auto;
  }
  .mail-head {
    display: flex;
    gap: var(--s3);
    align-items: flex-start;
    padding-bottom: var(--s3);
    border-bottom: var(--rule-w) solid var(--rule);
  }
  .avatar {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: var(--sys);
    color: #fff;
    font-weight: var(--w-bold);
    font-size: var(--text-xs);
  }
  .mail-from {
    display: flex;
    justify-content: space-between;
    margin: 0;
    font-weight: var(--w-semi);
  }
  .mail-time {
    color: var(--ink-3);
    font-weight: var(--w-reg);
    font-size: var(--text-sm);
    font-variant-numeric: var(--figures);
  }
  .mail-subject {
    margin: 2px 0 0;
    font-size: var(--text-sm);
    font-weight: var(--w-reg);
    color: var(--ink-2);
    line-height: var(--lead-snug);
  }
  .tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s2);
    margin-top: var(--s3);
  }
  .tile {
    background: var(--ground);
    border-radius: 10px;
    padding: var(--s3);
    min-width: 0;
  }
  .tile.wide {
    grid-column: 1 / -1;
  }
  .tile-head {
    display: flex;
    align-items: center;
    gap: var(--s2);
    margin: 0 0 var(--s2);
    font-size: var(--text-sm);
    font-weight: var(--w-semi);
    color: var(--ink-2);
  }
  .count {
    margin-left: auto;
    color: var(--ink);
    font-weight: var(--w-bold);
  }
  .follow {
    display: block;
    background: var(--panel);
    border-radius: 8px;
    padding: var(--s3);
    text-decoration: none;
    color: var(--ink);
    box-shadow: 0 0 0 2px var(--need);
  }
  .follow-who {
    display: block;
    font-weight: var(--w-semi);
  }
  .follow-what {
    display: block;
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: var(--lead-snug);
    margin-top: 2px;
  }
  .follow-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--s2);
  }
  .state {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--text-xs);
    font-weight: var(--w-semi);
    padding: 2px 8px;
    border-radius: 999px;
  }
  .state.need {
    background: var(--need-tint);
    color: var(--ink);
  }
  .follow-cue {
    color: var(--sys);
    font-weight: var(--w-semi);
    font-size: var(--text-sm);
  }
  .others {
    list-style: none;
    margin: var(--s2) 0 0;
    padding: 0;
    display: grid;
    gap: 2px;
    font-size: var(--text-sm);
  }
  .muted {
    color: var(--ink-3);
  }
  .bar {
    display: flex;
    gap: 2px;
    height: 12px;
    border-radius: 4px;
    overflow: hidden;
  }
  .seg.notdue { background: #aab8bf; }
  .seg.overdue { background: var(--over); }
  .bar-key {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s1) var(--s3);
    margin: var(--s2) 0 0;
    font-size: var(--text-xs);
    color: var(--ink-2);
  }
  .bar-key span { display: inline-flex; align-items: center; gap: 4px; }
  .sw { display: inline-block; width: 10px; height: 10px; border-radius: 2px; }
  .sw.notdue { background: #aab8bf; }
  .over-txt { color: var(--over); font-weight: var(--w-semi); }
  .paid {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: var(--s2) 0 0;
    font-size: var(--text-sm);
    color: var(--done);
    font-weight: var(--w-semi);
  }
  .big {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: var(--w-bold);
    line-height: 1.1;
  }
  .big span {
    display: block;
    font-size: var(--text-xs);
    font-weight: var(--w-reg);
    color: var(--ink-2);
  }
  .big.over-txt span { color: var(--ink-2); }
  .week {
    list-style: none;
    margin: var(--s2) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 3px;
  }
  .week li { display: grid; gap: 3px; justify-items: center; }
  .dots {
    display: flex;
    flex-direction: column-reverse;
    gap: 2px;
    height: 22px;
    justify-content: flex-start;
  }
  .dots i { display: block; width: 14px; height: 6px; border-radius: 2px; background: var(--sys); }
  .d { font-size: 11px; color: var(--ink-3); }
  .spark { display: block; width: 100%; height: 40px; margin-top: var(--s1); }
  .spark-key { display: flex; justify-content: space-between; margin: 0; font-size: 11px; color: var(--ink-3); }
  .today { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; font-size: var(--text-sm); }
  .honesty {
    margin: var(--s3) 0 0;
    text-align: center;
    font-size: var(--text-xs);
    color: var(--ink-2);
  }
</style>
