---
// Beat 4 of 4: zoom out to the week. The money bar (the followed job moves
// from overdue to paid when beat 3 is approved), the supplier price line, and
// tomorrow's 07:00 email, which picks up whatever the reader approved above.
// Renders the end state without JS; flow.ts adds .pre on load.
import Icon from './Icon.astro';
import { formatMoney } from '../../lib/money';
import { type Trade, followedJob, priceDriftPct, cheaperByPence } from '../../data/trades';

interface Props { trade: Trade }
const { trade: t } = Astro.props;
const j = followedJob(t);
const money = (p: number) => formatMoney(p, 'GBP');

// Money bar: same total before and after; only the followed job moves.
const overdueBase = t.overdue.reduce((s, o) => s + o.amountPence, 0);
const notDue = Math.max(0, t.invoicedPence - t.paidPence);
const pre = { paid: t.paidPence, notDue, over: overdueBase + j.pricePence };
const post = { paid: t.paidPence + j.pricePence, notDue, over: overdueBase };
const total = pre.paid + pre.notDue + pre.over;
const pct = (v: number) => `${((v / total) * 100).toFixed(2)}%`;

// Price line: the flagged supplier over time, the rival as one grey point.
const flagged = t.prices.find((p) => p.flagged)!;
const series = t.prices.filter((p) => p.supplier === flagged.supplier);
const rival = t.prices.find((p) => p.when === flagged.when && p.supplier !== flagged.supplier);
const all = [...series, ...(rival ? [rival] : [])].map((p) => p.unitPence);
const lo = Math.min(...all), hi = Math.max(...all);
const W = 320, H = 150, L = 24, R = 64, T = 22, B = 118;
const x = (i: number) => L + (i * (W - L - R)) / Math.max(1, series.length - 1);
const y = (v: number) => B - ((v - lo) / (hi - lo || 1)) * (B - T);
const pts = series.map((p, i) => [x(i), y(p.unitPence)] as const);
const last = pts[pts.length - 1];
const drift = priceDriftPct(t);
const cheaper = cheaperByPence(t);
const partShort = t.part.split(',')[0];
const nextWeek = t.jobs.length + 1;
---
<section class="beat pre-able" id="beat-4" aria-labelledby="beat-4-title" data-week>
  <p class="beat-meta"><span>Step 4 of 4</span><span class="area"><Icon name="sun" size={16} /> Your week</span></p>
  <h2 id="beat-4-title">Then it adds up your week</h2>

  <div data-stop="week">
    <div class="block rv">
      <p class="b-head">Money this week</p>
      <div class="bar" role="img" aria-label={`Paid ${money(post.paid)}, not due yet ${money(notDue)}, overdue ${money(post.over)}`}>
        <span class="seg paid" style={`--pre:${pct(pre.paid)};--post:${pct(post.paid)}`}></span>
        <span class="seg notdue" style={`--pre:${pct(notDue)};--post:${pct(notDue)}`}></span>
        <span class="seg over" style={`--pre:${pct(pre.over)};--post:${pct(post.over)}`}></span>
      </div>
      <ul class="key">
        <li class="k-paid"><Icon name="check" size={14} /> Paid <b><span class="v-pre">{money(pre.paid)}</span><span class="v-post">{money(post.paid)}</span></b> <em class="v-post plus">+{money(j.pricePence)} from <span data-bind="first-name">{j.first}</span></em></li>
        <li><i class="sw"></i> Not due yet <b>{money(notDue)}</b></li>
        <li class="k-over"><Icon name="alert" size={14} /> Overdue <b><span class="v-pre">{money(pre.over)}</span><span class="v-post">{money(post.over)}</span></b></li>
      </ul>
    </div>

    <div class="block rv" style="--i:1">
      <p class="b-head">{partShort}: <span class="over-txt">up {drift}% since {series[0].when}</span></p>
      <svg class="chart" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${flagged.supplier}: ${series.map((p) => `${p.when} ${money(p.unitPence)}`).join(', ')}.${rival ? ` ${rival.supplier}: ${money(rival.unitPence)} this week.` : ''}`}>
        <line x1={L - 8} x2={W - R + 8} y1={B + 12} y2={B + 12} stroke="var(--rule)" stroke-width="1"></line>
        {series.map((p, i) => <text x={x(i)} y={H - 4} text-anchor="middle" class="ax">{p.when}</text>)}
        <polyline points={pts.map((p) => p.join(',')).join(' ')} fill="none" stroke="var(--over)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></polyline>
        {pts.map((p, i) => (
          <circle cx={p[0]} cy={p[1]} r={i === pts.length - 1 ? 5 : 3.5} fill={i === pts.length - 1 ? 'var(--over)' : 'var(--panel)'} stroke="var(--over)" stroke-width="2"></circle>
        ))}
        {pts.slice(0, -1).map((p, i) => <text x={p[0]} y={p[1] - 10} text-anchor="middle" class="val">{money(series[i].unitPence)}</text>)}
        <text x={last[0] + 10} y={last[1] + 4} class="val strong over">{money(flagged.unitPence)}</text>
        {rival && (
          <>
            <circle cx={last[0]} cy={y(rival.unitPence)} r="4.5" fill="var(--ink-3)"></circle>
            <text x={last[0] + 10} y={y(rival.unitPence) + 4} class="val">{money(rival.unitPence)}</text>
          </>
        )}
      </svg>
      <ul class="legend">
        <li><i class="ln"></i> {flagged.supplier}</li>
        {rival && <li><i class="dt"></i> {rival.supplier}, {money(cheaper)} cheaper</li>}
      </ul>
    </div>

    <article class="tomorrow rv" style="--i:2" aria-label="Tomorrow's morning email">
      <p class="tm-head"><span class="tm-from">Morning brief</span><span class="tm-time">Tomorrow, 07:00</span></p>
      <p class="tm-subject">Morning, <span data-bind="owner">{t.owner}</span>.</p>
      <ul class="tm-lines">
        <li class="tm-need v-pre"><Icon name="alert" size={15} /> <span>Chaser for <span data-bind="first-name">{j.first}</span> is waiting for your tap</span></li>
        <li class="tm-done v-post"><Icon name="check" size={15} /> <span><span data-bind="customer">{j.from}</span> paid {money(j.pricePence)}</span></li>
        <li class="tm-sys" data-cascade-line hidden><Icon name="calendar" size={15} /> <span data-cascade-text></span></li>
        <li><Icon name="calendar" size={15} /> <span>{nextWeek} jobs booked next week</span></li>
        {rival && <li><Icon name="trend" size={15} /> <span>{partShort} is {money(cheaper)} cheaper at {rival.supplier}</span></li>}
      </ul>
    </article>
  </div>
  <p class="who">One message a morning. Everything else runs without you.</p>
</section>

<style>
  .beat { background: var(--panel); border-radius: 20px; padding: var(--s5) var(--s4); }
  .beat-meta { display: flex; justify-content: space-between; margin: 0 0 var(--s2); font-size: var(--text-sm); color: var(--ink-3); }
  .area { display: inline-flex; align-items: center; gap: 4px; color: var(--ink-2); font-weight: var(--w-semi); }
  h2 { margin: 0 0 var(--s5); font-size: var(--text-lg); font-weight: var(--w-bold); line-height: var(--lead-snug); }
  .block + .block { margin-top: var(--s5); padding-top: var(--s4); border-top: var(--rule-w) solid var(--rule); }
  .b-head { margin: 0 0 var(--s3); font-weight: var(--w-semi); }
  .over-txt { color: var(--over); }

  .bar { display: flex; gap: 2px; height: 16px; border-radius: 5px; overflow: hidden; }
  .seg { width: var(--post); transition: width 0.7s var(--ease-out); }
  .pre-able.pre .seg { width: var(--pre); }
  .seg.paid { background: var(--done); }
  .seg.notdue { background: var(--track); }
  .seg.over { background: var(--over); }
  .key { list-style: none; margin: var(--s3) 0 0; padding: 0; display: grid; gap: 4px; font-size: var(--text-sm); color: var(--ink-2); }
  .key li { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 6px; }
  .key b { color: var(--ink); font-variant-numeric: var(--figures); }
  .k-paid { color: var(--done); font-weight: var(--w-semi); }
  .k-over { color: var(--over); font-weight: var(--w-semi); }
  .plus { font-style: normal; font-size: var(--text-xs); background: var(--done-tint); color: var(--done); padding: 1px 8px; border-radius: 999px; }
  .sw { display: inline-block; width: 12px; height: 12px; border-radius: 3px; background: var(--track); }
  .pre-able .v-pre, .pre-able.pre .v-post { display: none; }
  .pre-able.pre .v-pre { display: inline; }
  .pre-able.pre li.v-pre { display: flex; }

  .chart { display: block; width: 100%; max-width: 26rem; height: auto; overflow: visible; }
  .ax { font-size: 11px; fill: var(--ink-3); }
  .val { font-size: 12px; fill: var(--ink-2); font-variant-numeric: tabular-nums; }
  .val.strong { font-weight: 700; }
  .val.over { fill: var(--over); }
  .legend { list-style: none; margin: var(--s2) 0 0; padding: 0; display: grid; gap: 2px; font-size: var(--text-xs); color: var(--ink-2); }
  .legend li { display: flex; align-items: center; gap: 6px; }
  .ln { display: inline-block; width: 16px; height: 3px; border-radius: 2px; background: var(--over); }
  .dt { display: inline-block; width: 9px; height: 9px; border-radius: 999px; background: var(--ink-3); margin: 0 3px; }

  .tomorrow { margin-top: var(--s5); background: var(--desk); border-radius: 14px; padding: var(--s3); }
  .tm-head, .tm-subject, .tm-lines { background: var(--panel); margin: 0; padding-inline: var(--s3); }
  .tm-head { display: flex; justify-content: space-between; padding-top: var(--s3); border-radius: 10px 10px 0 0; font-weight: var(--w-semi); font-size: var(--text-sm); }
  .tm-time { color: var(--ink-3); font-weight: var(--w-reg); font-size: var(--text-xs); }
  .tm-subject { font-weight: var(--w-bold); padding-bottom: var(--s2); border-bottom: var(--rule-w) solid var(--rule); }
  .tm-lines { list-style: none; padding-block: var(--s2) var(--s3); border-radius: 0 0 10px 10px; display: grid; gap: 6px; font-size: var(--text-sm); }
  .tm-lines li { display: flex; align-items: center; gap: 6px; }
  .tm-lines :global(.icon) { flex: 0 0 auto; }
  .tm-done { color: var(--done); font-weight: var(--w-semi); }
  .tm-need { font-weight: var(--w-semi); background: var(--need-tint); border-radius: 6px; padding: 2px 6px; margin-inline: -6px; }
  .tm-sys { color: var(--sys); font-weight: var(--w-semi); }
  .tm-sys[hidden] { display: none; }
  .who { margin: var(--s5) 0 0; padding-top: var(--s4); border-top: var(--rule-w) solid var(--rule); color: var(--ink-2); font-size: var(--text-sm); }
</style>
