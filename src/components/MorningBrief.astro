---
// The Morning Brief stage. The message a system like this sends the owner at
// 07:00, shown as a record: sender line, the day, six marked lines, then today.
// Each line is a real link down to the paperwork it stands on. Job-sheet
// aesthetic: white paper, grey rules, one amber highlighter on the bit that
// needs the owner. No phone bezel, no chat bubble.
import { BRIEF } from '../data/site';
---

<section class="brief-wrap" aria-labelledby="brief-heading">
  <div class="brief-inner">
    <p class="lead-in">Every morning, one message. This is yesterday's.</p>

    <article class="stage">
      <header class="msg-head">
        <span class="clock">{BRIEF.time}</span>
        <span class="to">{BRIEF.to}</span>
      </header>

      <h2 id="brief-heading" class="day">{BRIEF.dayLabel}</h2>

      <ol class="lines">
        {BRIEF.lines.map((line) => (
          <li>
            <a class="line" href={`#${line.anchor}`}>
              <span class="line-text"><span class="mark">{line.mark}</span> {line.rest}</span>
              <span class="chev" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="15" height="15" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" d="M6 3l5 5-5 5"></path></svg>
              </span>
            </a>
          </li>
        ))}
      </ol>

      <div class="today">
        <h3>Today</h3>
        <ul>
          {BRIEF.today.map((t) => <li>{t}</li>)}
        </ul>
      </div>
    </article>

    <p class="under">{BRIEF.underLine}</p>
    <p class="mocknote">{BRIEF.mockNote}</p>
  </div>
</section>

<style>
  .brief-wrap {
    background: var(--panel);
    padding: var(--s6) 0 var(--s5);
  }
  .brief-inner {
    max-width: 46rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .lead-in {
    font-size: var(--text-md);
    color: var(--ink-2);
    margin: 0 0 var(--s4);
  }

  /* The message record sits on a faint-teal mat: the one deliberate teal moment,
     lifting the white paper without washing the whole page. */
  .stage {
    background: var(--ground);
    border: var(--rule-w) solid var(--rule);
    border-radius: var(--radius);
    padding: var(--s5);
  }
  .msg-head {
    display: flex;
    align-items: baseline;
    gap: var(--s3);
    padding-bottom: var(--s3);
    border-bottom: var(--rule-w) solid var(--rule);
  }
  .clock {
    font-variant-numeric: var(--figures);
    font-weight: var(--w-bold);
    color: var(--teal);
    font-size: var(--text-md);
  }
  .to {
    color: var(--ink-2);
    font-size: var(--text-sm);
  }
  .day {
    font-size: var(--text-sm);
    font-weight: var(--w-semi);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-2);
    margin: var(--s4) 0 var(--s2);
  }

  .lines {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .lines li {
    border-bottom: var(--rule-w) solid var(--rule);
  }
  .line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s3);
    padding: var(--s4) var(--s2) var(--s4) 0;
    text-decoration: none;
    color: var(--ink);
  }
  .line-text {
    font-size: var(--text-md);
    line-height: var(--lead-snug);
  }
  .mark {
    background: linear-gradient(transparent 12%, var(--mark) 12% 88%, transparent 88%);
    padding: 0 0.12em;
    font-weight: var(--w-semi);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .chev {
    flex: 0 0 auto;
    color: var(--teal);
    display: grid;
    place-items: center;
  }
  .line:hover .line-text,
  .line:focus-visible .line-text {
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 3px;
  }

  .today {
    margin-top: var(--s4);
    padding-top: var(--s4);
    border-top: 2px solid var(--rule);
  }
  .today h3 {
    font-size: var(--text-sm);
    font-weight: var(--w-semi);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-2);
    margin: 0 0 var(--s2);
  }
  .today ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s2);
  }
  .today li {
    font-size: var(--text-base);
    color: var(--ink);
    line-height: var(--lead-snug);
  }

  .under {
    margin: var(--s4) 0 0;
    font-size: var(--text-md);
    color: var(--ink);
  }
  .mocknote {
    margin: var(--s3) 0 0;
    font-size: var(--text-sm);
    color: var(--ink-3);
    line-height: var(--lead-text);
    max-width: 56ch;
  }
</style>
