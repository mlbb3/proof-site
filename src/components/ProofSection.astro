---
import { PROOF_LEAD, PROOF_CARDS, PROOF_NOTE } from '../data/site';
---

<section class="proof" aria-labelledby="proof-lead">
  <div class="proof-inner">
    <p class="lead" id="proof-lead">{PROOF_LEAD}</p>

    <div class="cards">
      {PROOF_CARDS.map((card) => (
        <article class="card panel">
          <p class="kicker">
            <span class="dot" aria-hidden="true"></span>{card.kicker}
          </p>
          <h2>{card.heading}</h2>
          <p class="body">{card.body}</p>
          {card.live && <p class="live">{card.live}</p>}
        </article>
      ))}
    </div>

    <p class="note">{PROOF_NOTE}</p>
  </div>
</section>

<style>
  .proof {
    background: var(--ground);
    padding: var(--s6) 0;
  }
  .proof-inner {
    max-width: 46rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .lead {
    font-size: var(--text-lg);
    font-weight: var(--w-medium);
    line-height: var(--lead-snug);
    max-width: 30ch;
    margin: 0 0 var(--s6);
  }
  .cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s4);
  }
  .card {
    padding: var(--s5);
    border: var(--rule-w) solid var(--rule);
  }
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    font-size: var(--text-xs);
    font-weight: var(--w-semi);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--teal);
    margin: 0 0 var(--s3);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--sage);
    box-shadow: 0 0 0 3px var(--sage-tint);
  }
  h2 {
    font-size: var(--text-lg);
    font-weight: var(--w-bold);
    line-height: var(--lead-snug);
    margin: 0 0 var(--s3);
  }
  .body {
    color: var(--ink-2);
    line-height: var(--lead-text);
    margin: 0;
  }
  .live {
    margin: var(--s4) 0 0;
    padding-top: var(--s3);
    border-top: var(--rule-w) solid var(--rule);
    font-size: var(--text-sm);
    font-weight: var(--w-medium);
    color: var(--ink);
  }
  .note {
    margin: var(--s5) 0 0;
    font-size: var(--text-md);
    color: var(--ink-2);
    max-width: 46ch;
  }
  @media (min-width: 700px) {
    .cards {
      grid-template-columns: 1fr 1fr;
      gap: var(--s5);
    }
  }
</style>
